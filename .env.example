# ========================================================
# Resume Screening AI - Database & Server Configuration
# ========================================================

PORT=4000

# --------------------------------------------------------
# OPTION 1: External Database via Connection String URI
# Works with TiDB Cloud, Aiven, Railway, Supabase, Neon, AWS RDS, etc.
# --------------------------------------------------------
# DATABASE_URL=mysql://username:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/resumedb?ssl=true

# --------------------------------------------------------
# OPTION 2: External Database via Individual Parameters
# --------------------------------------------------------
# DB_HOST=your-external-db-host.com
# DB_PORT=3306
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_NAME=resume_screening_db
# DB_SSL=true

# --------------------------------------------------------
# Note: If no external DB credentials are provided, the
# application will automatically fall back to local SQLite
# (database/resumes.db) with zero setup required.
# --------------------------------------------------------
